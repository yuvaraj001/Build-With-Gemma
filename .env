

# Application Environment
APEX_ENV=demo
APEX_MODEL_ADAPTER=deterministic
APEX_GEMMA_MODEL=gemma-4-26b-a4b-it

# Data Source & Fallback Settings
APEX_OPENF1_ENABLED=true
APEX_OPENF1_TIMEOUT_SECONDS=3
APEX_USE_SEEDED_FIXTURE_FALLBACK=true
APEX_DEFAULT_SCENARIO=lap34_tire_cliff

# Agent Timeout Budgets (in milliseconds)
APEX_TELEMETRY_TIMEOUT_MS=700
APEX_COMPETITOR_TIMEOUT_MS=700
APEX_RADIO_TIMEOUT_MS=1500
APEX_COORDINATOR_TIMEOUT_MS=10000
APEX_VALIDATION_TIMEOUT_MS=300

# Feature Flags
APEX_ENABLE_RACE_CONTROL=true
APEX_ENABLE_TTS=true
APEX_LOG_LEVEL=INFO
